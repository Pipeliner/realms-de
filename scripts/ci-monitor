#!/usr/bin/env bash
set -euo pipefail

# Read-only monitor for the required main-branch GitHub workflow matrix.
# Packaging and workflow mutation remain CI-only and are never performed here.

interval=${CI_MONITOR_INTERVAL_SECONDS:-30}
max_seconds=${CI_MONITOR_MAX_SECONDS:-1800}
if [[ ! $interval =~ ^[1-9][0-9]*$ || ! $max_seconds =~ ^[1-9][0-9]*$ ]]; then
  printf '%s\n' 'monitor timing settings must be positive decimal integers' >&2
  exit 64
fi
mode=once
if [[ ${1:-} == "--watch" ]]; then
  mode=watch
fi

started=$(date +%s)
repo=$(timeout "$(( max_seconds < 30 ? max_seconds : 30 ))" gh repo view --json nameWithOwner --jq .nameWithOwner)

snapshot() {
  local deadline=$(( $(date +%s) + $1 )) status remaining response runs query all='[]'
  local -a pagination
  for status in recent queued pending waiting requested in_progress; do
    remaining=$(( deadline - $(date +%s) ))
    (( remaining > 0 )) || return 124
    pagination=()
    query="repos/$repo/actions/runs?branch=main&per_page=30"
    if [[ $status != recent ]]; then
      query="repos/$repo/actions/runs?branch=main&status=$status&per_page=100"
      pagination=(--paginate)
    fi
    response=$(timeout "$(( remaining < 30 ? remaining : 30 ))" gh api "$query" "${pagination[@]}") || return
    runs=$(printf '%s\n' "$response" | jq -cs --arg status "$status" '
      if length == 0 or any(.[]; (.workflow_runs | type) != "array" or (.total_count | type) != "number")
      then error("invalid workflow run response") else
        ([.[].workflow_runs[]]) as $runs |
        if $status != "recent" and ($runs | length) < (map(.total_count) | max)
        then error("incomplete nonterminal workflow history")
        else $runs | map({id,name,status,conclusion,head_branch,head_sha,updated_at}) end
      end') || return
    all=$(printf '%s\n%s\n' "$all" "$runs" | jq -cs add) || return
  done
  printf '%s\n' "$all" | jq -r '
    group_by(.id)[] | ((map(select(.status != "completed")) + .)[0]) |
    select(.head_branch == "main" and (.name == "ci" or .name == "distro" or .name == "palette")) |
    [.id,.name,.status,(.conclusion // ""),.head_sha,.updated_at] | @tsv'
}

if [[ $mode == once ]]; then
  snapshot "$(( max_seconds - ($(date +%s) - started) ))"
  exit 0
fi

last_status=1
while :; do
  now=$(date +%s)
  remaining=$(( max_seconds - (now - started) ))
  if (( remaining <= 0 )); then
    exit "$last_status"
  fi
  query_status=0
  state=$(snapshot "$remaining" 2>&1) || query_status=$?
  if (( query_status != 0 )); then
    last_status=$(( query_status == 124 ? 124 : 1 ))
    printf '%s monitor query failed; retrying\n' "$(date -u +%FT%TZ)" >&2
    printf '%s\n' "$state" >&2
  else
    last_status=124
    printf '%s\n' "$state"
    if ! printf '%s\n' "$state" | awk -F '\t' 'NF && $3 != "completed" { active=1 } END { exit !active }'; then
      exit 0
    fi
  fi
  now=$(date +%s)
  remaining=$(( max_seconds - (now - started) ))
  if (( remaining <= 0 )); then
    exit "$last_status"
  fi
  sleep "$(( interval < remaining ? interval : remaining ))"
done
