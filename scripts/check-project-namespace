#!/usr/bin/env python3
"""Reject the retired project token in every tracked path and file byte stream."""

from __future__ import annotations

import os
import subprocess
import sys
import tarfile
from pathlib import Path


RETIRED = bytes((104, 101, 108, 109))
WORKSPACE_ARCHIVE = Path("packaging/tool-sources/bundles/realm-workspace/source.tar.gz")


def tracked_paths() -> list[bytes]:
    result = subprocess.run(
        ["git", "ls-files", "-z"],
        check=True,
        stdout=subprocess.PIPE,
    )
    return [path for path in result.stdout.split(b"\0") if path]


def content(path: Path) -> bytes:
    if path.is_symlink():
        return os.fsencode(os.readlink(path))
    return path.read_bytes()


def archive_failures(archive: Path) -> list[str]:
    failures: list[str] = []
    with tarfile.open(archive, mode="r:gz") as contents:
        for member in contents.getmembers():
            if RETIRED in os.fsencode(member.name).lower():
                failures.append(f"retired namespace in archive path: {member.name}")
            if not member.isfile():
                continue
            source = contents.extractfile(member)
            if source is not None and RETIRED in source.read().lower():
                failures.append(f"retired namespace in archive content: {member.name}")
    return failures


def main() -> int:
    failures: list[str] = []
    for raw_path in tracked_paths():
        path = Path(os.fsdecode(raw_path))
        if RETIRED in raw_path.lower():
            failures.append(f"retired namespace in path: {path}")
        if RETIRED in content(path).lower():
            failures.append(f"retired namespace in content: {path}")

    if WORKSPACE_ARCHIVE in [Path(os.fsdecode(path)) for path in tracked_paths()]:
        failures.extend(archive_failures(WORKSPACE_ARCHIVE))

    if failures:
        print("project namespace check failed", file=sys.stderr)
        for failure in failures:
            print(failure, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
