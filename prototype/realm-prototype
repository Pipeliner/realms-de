#!/bin/sh
# Run the packaged desktop from a checkout or an extracted CI artifact.
set -eu

if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    printf 'realm-prototype: start from a TTY outside an existing desktop session; nested launch is unsupported.\n' >&2
    exit 1
fi

case $0 in
    */*) launcher=$0 ;;
    *) launcher=$(command -v "$0") ;;
esac
prototype_dir=$(CDPATH='' cd -- "${launcher%/*}" && pwd -P)
config=$prototype_dir/sway.conf

if [ ! -r "$config" ]; then
    printf 'realm-prototype: missing adjacent config: %s\n' "$config" >&2
    exit 1
fi

missing=''
for command in sway swaymsg swaybar foot fuzzel thunar i3status swayidle swaylock xdg-open; do
    if ! command -v "$command" >/dev/null 2>&1; then
        missing="$missing $command"
    fi
done
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && ! command -v dbus-run-session >/dev/null 2>&1; then
    missing="$missing dbus-run-session"
fi
if [ -n "$missing" ]; then
    printf 'realm-prototype: missing required commands:%s\nInstall the distribution packages listed in README.md before launching.\n' "$missing" >&2
    exit 1
fi
if ! command -v brightnessctl >/dev/null 2>&1; then
    printf 'realm-prototype: brightnessctl is absent; idle dim is unavailable. Lock/blank remains configured.\n' >&2
fi

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- sway --config "$config" "$@"
fi
exec sway --config "$config" "$@"
