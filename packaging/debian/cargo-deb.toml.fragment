# cargo-deb metadata — the alternative .deb path.
#
# WHERE THIS GOES: append this block to the ROOT Cargo.toml (or to the manifest
# of whichever crate becomes the packaged binary once one exists). It is kept
# here as a fragment because the root Cargo.toml belongs to the workspace owner,
# not to packaging.
#
# WHEN TO USE WHICH:
#   * debian/ (control + rules) is the path that produces a *source* package,
#     builds in a clean chroot and could go to a PPA or Debian proper.
#   * cargo-deb is the path that turns an already-built release binary into a
#     .deb in one command — right for CI artefacts and for people who just want
#     a file to install. It does not produce a source package.
# Keep the two in step: the dependency list below mirrors debian/control, and a
# change to one is a change to both.
#
# PRE-ALPHA: this fragment is not wired into a package manifest or exercised by
# native CI. If that alternate route is activated, it must first gain the same
# retained Yazi/Starship staging and private payload as debian/rules; listing
# outputs that only debian/rules creates would make this fragment misleading.

[package.metadata.deb]
name = "realm"
maintainer = "realm contributors <vadim.evard@gmail.com>"  # Keep synchronized with debian/control.
copyright = "2026 the realm contributors"
license-file = ["LICENSE-MIT", "0"]
extended-description = """
realm is a Wayland desktop built around one idea: an ordered ledger of windows is
the only state that matters, and every layout is a pure projection of it.

PRE-ALPHA. This metadata requires realmctl, realm-wm and realm-bar plus the
session contract. Native installation and graphical login remain unverified."""
section = "x11"
priority = "optional"
depends = "$auto, realm-river (>= 0.4.0) | river (>= 0.4.0), dbus-user-session, systemd, xdg-desktop-portal, xdg-desktop-portal-gtk, xdg-desktop-portal-wlr, foot, fuzzel, btop, zsh"
recommends = "fonts-ibm-plex, fonts-symbola, gsettings-desktop-schemas, xwayland, slurp"

# Paths are relative to the workspace root; the trailing component is the
# destination. Mirrors packaging/debian/install.
assets = [
    ["packaging/session/realm-session", "usr/bin/", "755"],
    ["packaging/session/realm.desktop", "usr/share/wayland-sessions/", "644"],
    ["palette.toml", "usr/share/realm/", "644"],
    ["configs/portal/realm-portals.conf", "usr/share/xdg-desktop-portal/", "644"],
    ["docs/INSTALL.md", "usr/share/doc/realm/", "644"],
    ["target/release/realmctl", "usr/bin/", "755"],
    ["target/release/realm-wm", "usr/bin/", "755"],
    ["target/release/realm-bar", "usr/bin/", "755"],
]

# cargo-deb installs these into /usr/lib/systemd/user and generates the enable
# snippets. `enable = true` is what creates the realm-session.target.wants
# symlinks; without them, starting the session target starts nothing at all and
# reports success (SPEC 0005 §4).
#
# UNVERIFIED, and it matters: cargo-deb's systemd-units handling is
# single-unit-oriented and its behaviour for a *target* with two wanted services
# has not been exercised here (the fragment is not wired into a manifest).
# If it turns out not to create both symlinks, add them as assets pointing at a
# checked-in symlink tree, the way packaging/debian/rules does explicitly.
[package.metadata.deb.systemd-units]
unit-scripts = "packaging/systemd"
unit-name = "realm-bar"
enable = true
start = false
