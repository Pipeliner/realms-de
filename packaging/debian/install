# Static files, mapped from the source tree into the binary package.
# Built binaries are handled by override_dh_auto_install in debian/rules,
# because none of them exist yet (pre-alpha) and dh_install fails on a missing
# source file.
#
# The wrapper is committed executable, and dh_install preserves that.
packaging/session/helm-session          usr/bin
packaging/session/helm.desktop          usr/share/wayland-sessions
packaging/systemd/helm-session.target   usr/lib/systemd/user
packaging/systemd/helm-daemon.service   usr/lib/systemd/user
packaging/systemd/helm-bar.service      usr/lib/systemd/user
palette.toml                            usr/share/helm
# configs/ is generated by the theming pipeline (M1) and is empty today. When it
# lands, the portal configuration goes here — the session contract expects a
# backend named per interface rather than whatever happens to be installed:
# configs/portal/helm-portals.conf      usr/share/xdg-desktop-portal
