#!/usr/bin/make -f
# helm — Debian rules.
#
# HOW THIS DIRECTORY IS USED. Construct the retained-only Debian source kit,
# then run dpkg-buildpackage from that kit. It contains this directory as
# ./debian plus the retained Helm authority; it does not contain a checkout:
#
#     packaging/tool-sources/build-native-source-kits.sh /tmp/helm-kits
#     cd /tmp/helm-kits/helm-debian-0.1.0
#     dpkg-buildpackage -us -uc -b
#
# PRE-ALPHA (0.1.0): this workspace builds `helmctl` for the implemented theme
# commands. override_dh_auto_install installs every built Helm binary, so
# helm-wm and helm-bar can land without another packaging change.
#
# NEEDS-HUMAN — the vendored river (helm-river) this package depends on is NOT
# built by these rules, and building it is not a trivial recipe:
#   * Ubuntu 24.04 ships no river at all, and no zig (both verified against
#     noble's apt lists on 2026-08-26).
#   * river 0.4.8 needs zig 0.16 and wlroots 0.20; noble carries only
#     libwlroots-dev 0.17 (verified). So a vendored river needs a vendored
#     wlroots too, or a statically linked build.
# Options, none of which should be guessed at in a Makefile:
#   (a) build helm-river in a container from the upstream tag
#       (https://codeberg.org/river/river, verified as the source nixpkgs uses)
#       with an upstream zig toolchain and a private wlroots 0.20, shipped under
#       /usr/lib/helm/ with an rpath;
#   (b) ship river built by upstream/CI as a binary artefact and package that;
#   (c) require a third-party PPA that already carries river 0.4.x;
#   (d) raise the minimum Ubuntu to a release carrying river 0.4.x and wlroots
#       0.20, and drop the vendoring entirely.
# Whoever owns the build pipeline picks one and writes debian/rules for a
# separate `helm-river` source package. No zig invocation is invented here
# because none has been verified.

export DH_VERBOSE = 1

# The Debian source kit carries no checkout of the Helm workspace. Both Cargo
# inputs are staged from the retained, digest-bound authority before use.
HELM_BUNDLE := $(CURDIR)/packaging/tool-sources/bundles/helm-workspace
HELM_STAGE := $(CURDIR)/debian/helm-workspace
HELM_STAGER := $(CURDIR)/packaging/tool-sources/stage-helm-workspace.py
HELM_KIT_CHECKER := $(CURDIR)/packaging/tool-sources/check-native-source-kit.py

# Keep Cargo state and build outputs package-local. CARGO_HOME starts empty;
# dependency resolution comes exclusively from HELM_STAGE/vendor.
export CARGO_HOME = $(CURDIR)/debian/.cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target
# Debian's own rustc/cargo are dfsg-repacked; helm only needs a compiler new
# enough for its MSRV.
export CARGO_TERM_COLOR = never

# Ubuntu 24.04's default cargo is 1.75, below helm's MSRV of 1.85. The
# versioned toolchain packages install under /usr/lib/rust-<version>/bin. The
# resolver accepts only a complete cargo/rustc pair and returns the newest
# matching path. Its Ubuntu 24.04 archive layout was verified on #104.
RUST_VERSIONED_GLOB := /usr/lib/rust-1.[89][0-9]/bin
DEBIAN_RULES_DIR := $(dir $(realpath $(firstword $(MAKEFILE_LIST))))
# Production resolves the distro-provided pair below /.  The retained-source
# fixture supplies a separate root with that identical versioned layout so its
# nested Debhelper make cannot silently fall back to host tooling.
HELM_RUST_VERSIONED_ROOT ?= /
HELM_RUST_VERSIONED_PREFIX := $(if $(filter /,$(HELM_RUST_VERSIONED_ROOT)),,$(patsubst %/,%,$(HELM_RUST_VERSIONED_ROOT)))
RUST_VERSIONED_LOGICAL_BIN := $(shell "$(DEBIAN_RULES_DIR)toolchain-path.sh" --root "$(HELM_RUST_VERSIONED_ROOT)")
RUST_VERSIONED_BIN := $(HELM_RUST_VERSIONED_PREFIX)$(RUST_VERSIONED_LOGICAL_BIN)
ifeq ($(strip $(RUST_VERSIONED_BIN)),)
$(error helm: missing Ubuntu versioned Rust toolchain directory: $(RUST_VERSIONED_GLOB))
endif
export PATH := $(RUST_VERSIONED_BIN):$(PATH)

%:
	dh $@

# helm is not autotools; there is nothing to configure.
override_dh_auto_configure:
	python3 "$(HELM_KIT_CHECKER)" debian "$(CURDIR)"

override_dh_auto_build:
	rm -rf "$(CARGO_HOME)" "$(CARGO_TARGET_DIR)"
	mkdir -p "$(CARGO_HOME)" "$(CARGO_TARGET_DIR)"
	@set -e; \
	helm_source="$$(python3 "$(HELM_STAGER)" "$(HELM_BUNDLE)" "$(HELM_STAGE)")"; \
	cd "$$helm_source"; \
	rustc --version | awk '{split($$2,v,"."); if (v[1] < 1 || (v[1] == 1 && v[2] < 85)) { \
		print "helm: rustc " $$2 " is older than the MSRV 1.85 declared in Cargo.toml."; \
		print "      Install rustc-1.85/cargo-1.85 (in the Ubuntu 24.04 archive) or newer."; \
		exit 1 }}'; \
	cargo build --release --frozen --offline --locked --workspace

override_dh_auto_test:
	# helm-core's tests include the palette lint, so a palette that fails its
	# WCAG floors fails the package build. That is deliberate (ADR 0005).
	# helm-agent-sdd is not packaged here and its gate fixtures require live Git
	# worktree state, which the canonical source archive deliberately omits.
	@set -e; \
	helm_source="$$(python3 "$(HELM_STAGER)" "$(HELM_BUNDLE)" "$(HELM_STAGE)")"; \
	cd "$$helm_source"; \
	cargo test --release --frozen --offline --locked --workspace \
		--exclude helm-agent-sdd

override_dh_auto_install:
	# The .wants symlinks, shipped rather than left to [Install] processing.
	# dh_installsystemduser does generate enable snippets for these units, but
	# SPEC 0005 §4 requires the symlinks to exist in the package on all three
	# distros: [Install] only takes effect when something runs it, and if the
	# symlinks are missing then `systemctl --user start helm-session.target`
	# starts *nothing at all* and exits 0.
	install -d debian/helm/usr/lib/systemd/user/helm-session.target.wants
	ln -sf ../helm-wm.service \
		debian/helm/usr/lib/systemd/user/helm-session.target.wants/helm-wm.service
	ln -sf ../helm-bar.service \
		debian/helm/usr/lib/systemd/user/helm-session.target.wants/helm-bar.service
	# Install whichever helm binaries this revision actually built. `helmctl` is
	# built now; the loop means helm-wm and helm-bar need no packaging change. The
	# names
	# are the settled ones: helm-wm (the window manager and session daemon) and
	# helmctl (the CLI, so it cannot collide with Kubernetes helm).
	set -e; \
	for bin in helmctl helm-wm helm-bar; do \
		if [ -x "$(CARGO_TARGET_DIR)/release/$$bin" ]; then \
			install -Dm755 "$(CARGO_TARGET_DIR)/release/$$bin" "debian/helm/usr/bin/$$bin"; \
			echo "installed $$bin"; \
		else \
			echo "skipping $$bin: not built in this revision"; \
		fi; \
	done

override_dh_auto_clean:
	rm -rf "$(HELM_STAGE)" "$(CARGO_HOME)" "$(CARGO_TARGET_DIR)"

# No hand-written maintainer scripts, on purpose. The only thing that would need
# one is enabling the systemd user units, and dh_installsystemduser generates
# those snippets itself from the units shipped into /usr/lib/systemd/user.
# Enabling is what creates the helm-session.target.wants symlinks, without which
# starting the session target would start nothing.
#
# Verified, not assumed: `dpkg-buildpackage -us -uc -b -d` on debhelper 13.14
# produced postinst/postrm snippets calling `deb-systemd-helper --user enable`
# for the units installed via debian/install. Those snippets are belt to the
# braces of the shipped .wants symlinks above: debhelper's enable writes into
# /etc/systemd/user, the shipped symlinks live beside the units in
# /usr/lib/systemd/user, and either one alone makes the target start something.
