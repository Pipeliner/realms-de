# helm — wayland session entry.
#
# Installed to /usr/share/wayland-sessions/helm.desktop, where every display
# manager (GDM, SDDM, greetd/tuigreet, LightDM) looks for wayland sessions.
# Exec must be an absolute path: display managers do not run it through a login
# shell, so /usr/local/bin is not necessarily on PATH.
#
# PRE-ALPHA (0.1.0): selecting this entry today gives you river 0.4 with helm's
# session environment contract applied — and nothing else. Under river 0.4 the
# compositor does no window management of its own; helm-sessiond is the window
# manager, and it lands in M2 together with the bar and the launcher. Until
# then this session is a compositor with nothing driving it. See
# docs/INSTALL.md, "what this actually installs today".
#
# The Nix module rewrites Exec/TryExec to the store path of the wrapper.
#
# `desktop-file-validate` warns that DesktopNames "should start with X-". Ignore
# it: that tool validates *application* entries, while DesktopNames is the key
# display managers read from a *session* entry to set XDG_CURRENT_DESKTOP — it
# is what every shipped session file (gnome.desktop, sway.desktop) uses. helm
# sets the same value in the wrapper, so a display manager that ignores this key
# still gets a correct session.
[Desktop Entry]
Name=helm
Comment=Keyboard-first, gapless-tiling Wayland desktop
Exec=/usr/bin/helm-session
TryExec=/usr/bin/helm-session
Type=Application
DesktopNames=helm
Keywords=tiling;wayland;keyboard;
