# The helm session daemon: owns HelmState, drives the WmBackend, serves the
# NDJSON control socket at $XDG_RUNTIME_DIR/helm/ctl.sock (helm-core::ipc).
#
# PRE-ALPHA (0.1.0): /usr/bin/helm-sessiond does not exist yet — the crate
# `helm-session` lands in M2. Until then this unit is installed but starting it
# fails with status 203/EXEC, which is why nothing Requires= it.
[Unit]
Description=helm session daemon
Documentation=https://github.com/pipeliner/realms-de/blob/main/docs/ARCHITECTURE.md
PartOf=graphical-session.target
After=graphical-session.target
# Refuse to start rather than come up displayless: a daemon that missed the
# environment handshake is the failure this whole session contract exists to
# prevent (docs/PITFALLS.md, "WAYLAND_DISPLAY never reaches D-Bus").
ConditionEnvironment=WAYLAND_DISPLAY
# Do not let a crash loop spin the CPU; five failures in 30 s is a real bug and
# should surface as a dead unit, not as a hot laptop.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
# Type=exec, not notify: the daemon does not implement sd_notify yet. Switch to
# Type=notify (and sd_notify READY=1 after the control socket is bound) in M2 so
# helm-bar.service can order itself after a socket that actually accepts.
Type=exec
ExecStart=/usr/bin/helm-sessiond
Restart=on-failure
RestartSec=1
Slice=session.slice
TimeoutStopSec=10

[Install]
WantedBy=helm-session.target
