# The realm bar: layer-shell bar, which-key strip, mode badge, chord echo.
#
# PRE-ALPHA (0.1.0): /usr/bin/realm-bar does not exist yet — the crate `realm-bar`
# lands in M2. The unit ships now so the session shape is testable.
#
# The dependency direction here is the point. The bar is Wanted, never Required,
# by realm-session.target, and nothing Binds to it: a crashed bar is restarted on
# its own and the session survives (docs/PITFALLS.md, "Session dies with a
# client" — a crashed bar must not black-screen the desktop). PartOf= propagates
# stop downwards; BindsTo= would propagate failure upwards, which is the bug.
#
# Under river the bar is a layer-shell client served by realm's own window
# manager, not by the compositor: if realm-wm is not attached, the bar maps
# nothing however healthy it is. Check realm-wm.service first.
[Unit]
Description=realm bar
Documentation=https://github.com/pipeliner/realms-de/blob/main/docs/ARCHITECTURE.md
PartOf=graphical-session.target
After=graphical-session.target realm-wm.service
# Wants, not Requires: the bar reconnects to the control socket on its own, so
# a daemon that is slow or briefly down — including a window manager restarting
# under river — must not keep the bar from running.
Wants=realm-wm.service
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Environment=PATH=/usr/lib/realm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Type=exec
ExecStart=/usr/bin/realm-bar
Restart=on-failure
RestartSec=1
# app.slice, not session.slice: under memory pressure the bar should be reaped
# before the window manager, because the bar is restartable and the window
# manager is the session.
Slice=app.slice
TimeoutStopSec=5

[Install]
WantedBy=realm-session.target
